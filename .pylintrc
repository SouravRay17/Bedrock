[MASTER]
ignore=CVS,.git,__pycache__,dist,node_modules,graphify-out,data
ignore-patterns=.*_test\.py,test_.*\.py
extension-pkg-whitelist=pydantic

[TYPECHECK]
ignored-classes=FieldInfo,BaseModel

[FORMAT]
max-line-length=120

[MESSAGES CONTROL]
disable=
    raw-checker-failed,
    bad-inline-option,
    locally-disabled,
    file-ignored,
    suppressed-message,
    useless-suppression,
    deprecated-pragma,
    use-symbolic-message-instead,
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    too-many-instance-attributes,
    too-many-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    broad-exception-caught,
    fixme
